; Engine configuration file.
; KAOS TAKIMI - Godot 4 proje ayarlari.
; Bu dosyayi elle degistirmek yerine Godot'ta "Proje > Proje Ayarlari" menusunu kullanin.

config_version=5

[application]

config/name="KAOS TAKIMI"
config/description="2D top-down online co-op party oyunu."
config/version="0.1.0"
run/main_scene="res://scenes/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0784314, 0.0627451, 0.156863, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/ui/main_theme.tres"

