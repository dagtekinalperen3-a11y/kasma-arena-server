{
  "name": "ters-bomba",
  "productName": "Ters Bomba",
  "version": "2.0.0",
  "description": "Ters Bomba - 3-5 kişilik kaotik co-op bomba imha oyunu",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "exe": "npm run build && electron-builder --win portable --x64",
    "exe:win": "npm run build && electron-builder --win portable --x64 -c.win.signAndEditExecutable=true",
    "steam": "npm run build && electron-builder --win dir --x64"
  },
  "devDependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/special-elite": "5.3.0",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "esbuild": "0.24.0",
    "peerjs": "1.5.4",
    "three": "0.160.0"
  },
  "build": {
    "appId": "com.tersbomba.oyun",
    "productName": "Ters Bomba",
    "files": [
      "electron/**",
      "dist-web/**"
    ],
    "directories": {
      "output": "exe"
    },
    "win": {
      "target": "portable",
      "icon": "electron/icon.png",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Ters-Bomba.exe"
    }
  }
}
