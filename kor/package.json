{
  "name": "kor-oyun",
  "productName": "KOR",
  "version": "2.0.0",
  "description": "KÖR - kör bir yaratıktan kaçtığın 3D korku oyunu",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "exe": "npm run build && electron-builder --win portable --x64",
    "exe:win": "npm run build && electron-builder --win portable --x64 -c.win.signAndEditExecutable=true"
  },
  "devDependencies": {
    "@fontsource/creepster": "5.2.5",
    "@fontsource/special-elite": "5.2.6",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "esbuild": "0.24.0",
    "three": "0.160.0"
  },
  "build": {
    "appId": "com.kor.korkuoyunu",
    "productName": "KOR",
    "files": [
      "electron/**",
      "dist-web/**"
    ],
    "directories": {
      "output": "exe"
    },
    "win": {
      "target": "portable",
      "icon": "electron/icon.png",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "KOR-Korku-Oyunu.exe"
    }
  }
}
